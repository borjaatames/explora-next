# URL pública del sitio (sin barra al final)
NEXT_PUBLIC_SITE_URL=https://exploraspain.com

# Permitir que buscadores indexen el sitio (true/false)
# Manten en false hasta tener 5 guias buenas listas
NEXT_PUBLIC_ALLOW_INDEXING=false

# URL del backend (Railway en el futuro)
NEXT_PUBLIC_API_URL=http://localhost:3001

# UUID del canal de reservas de Bokun (revendedor). Público: aparece en el
# embed del widget en el cliente. Lo da el panel de Bokun al generar el código.
NEXT_PUBLIC_BOKUN_CHANNEL_UUID=

# Access key del formulario de contacto (Web3Forms). Gratis en web3forms.com:
# pones tu email, te envían la clave. Sin esta variable el formulario cae a
# mostrar el email (mailto). Pública por diseño (solo permite enviarte a ti).
NEXT_PUBLIC_WEB3FORMS_KEY=
